# pi-brain environment configuration
# Copy this file to .env and adjust for your clone.

# LOCAL_FIRST=true means the agent commits phases directly to the current branch.
# LOCAL_FIRST=false means the agent opens a pull request for each phase.
# For the product repo and shared clones, PR-first is recommended.
LOCAL_FIRST="false"

# Optional: absolute path to the enola binary the integration should drive.
# Resolves before brain.config.yml's enola.binary and the PATH lookup, so a
# machine with several enola builds pins the right one per checkout.
# ENOLA_BINARY=
